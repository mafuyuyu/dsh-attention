{
  "name": "dsh-attention",
  "version": "0.2.4",
  "private": true,
  "description": "答题与审批提醒：DeepSeek Harness 等待回答 ask_user_question 时显示倒计时，权限审批时每分钟提示，支持自定义提示音与独立音量。",
  "author": "mafuyuyu",
  "license": "MIT",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ask-user-question",
    "approval",
    "countdown",
    "reminder",
    "timer"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "icon.svg",
    "assets",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node test/host-routes.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mafuyuyu/dsh-attention.git"
  },
  "homepage": "https://github.com/mafuyuyu/dsh-attention",
  "bugs": {
    "url": "https://github.com/mafuyuyu/dsh-attention/issues"
  }
}
